rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    function isDeveloper() {
      return isAuthenticated() && getUserData().role == 'developer';
    }
    function isClient() {
      return isAuthenticated() && getUserData().role == 'client';
    }
    
    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow write: if false; // Must use API for audit
    }
    
    match /clients/{clientId} {
      allow read: if isAdmin() || (isClient() && getUserData().clientId == clientId);
      allow write: if false; // Must use API for audit
    }
    
    match /projects/{projectId} {
      function isAssignedDeveloper() {
        return isDeveloper() && request.auth.uid in resource.data.developerIds;
      }
      function isOwnClientProject() {
        return isClient() && getUserData().clientId == resource.data.clientId;
      }
      
      allow read: if isAdmin() || isAssignedDeveloper() || isOwnClientProject();
      allow write: if false; // Using Server Actions / API for developer updates to ensure audit trails
      
      match /scope/{scopeId} {
        allow read: if isAdmin() || isAssignedDeveloper() || (isOwnClientProject() && resource.data.clientVisible == true);
        allow write: if false; // Must use API
      }
      
      match /milestones/{milestoneId} {
        allow read: if isAdmin() || isAssignedDeveloper() || isOwnClientProject();
        allow write: if false; // Must use API
      }
      
      match /updates/{updateId} {
        allow read: if isAdmin() || isAssignedDeveloper() || (isOwnClientProject() && resource.data.visibility == 'client');
        allow write: if false; 
      }
      
      match /timeline/{timelineId} {
        allow read: if isAdmin() || isAssignedDeveloper() || isOwnClientProject();
        allow write: if false; 
      }
    }
    
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
